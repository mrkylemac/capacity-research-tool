# ── Authentication ────────────────────────────────────────────────────────────

# Postgres connection string. Any Postgres works. On Vercel this is set for you
# by the Neon integration; see AUTH-SETUP.md.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signing secret for session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app. Locally this is http://localhost:3000. On Vercel it is
# inferred from VERCEL_URL, but set it explicitly for a custom domain.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that are auto-approved and made admin on signup.
# Somebody has to approve the first account — this is how. Everyone else signs
# up and waits for an admin to approve them at /admin/users.
ADMIN_EMAILS=hello@example.com

# Optional: notify admins by email when somebody requests access. Leave blank
# and signup still works — the send is skipped and logged, nothing fails.
# Key from resend.com/api-keys.
RESEND_API_KEY=

# Sender address. Resend's shared onboarding@resend.dev needs no DNS setup but
# only delivers to the address that owns the Resend account. Use an address on
# a verified domain to reach anyone else.
EMAIL_FROM=

# Optional: Google sign-in. Leave blank to show email/password only.
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Data sources ──────────────────────────────────────────────────────────────

# CapEx tracker data (optional)
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
